{
  "name": "sonoran-mintlify-migration-validation",
  "private": true,
  "type": "module",
  "description": "Syntax and hosted acceptance checks for the Sonoran Mintlify documentation migration.",
  "scripts": {
    "validate": "node validate-site.mjs --root ../../mintlify --source-root ../.. --manifest routing-manifest.json",
    "probe": "node probe-hosted.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "remark-gfm": "4.0.1"
  }
}
